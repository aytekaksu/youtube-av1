{
  "name": "youtube-av1",
  "version": "0.2.0",
  "private": true,
  "description": "A small extension that makes YouTube prefer AV1.",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node scripts/check.cjs && node tests/behavior.cjs && node tests/popup-state.cjs",
    "test:ui": "npm run build && node tests/popup.cjs",
    "package": "npm test && python3 scripts/package.py"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
